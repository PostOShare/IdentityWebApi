{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },  
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "LogPaths": {
    "InfoPath": "C://Users//deshd//Documents//IISWebAPIRepos//Logs//PostOShareIdentityWebAPI//info_YYYYMMDD.txt",
    "ErrorPath": "C://Users//deshd//Documents//IISWebAPIRepos//Logs//PostOShareIdentityWebAPI//error_YYYYMMDD.txt"
  },
  "AllowedHosts": "*",
  "MailSettings": {
    "Server": "", // Add smtp host
    "Port": 0, // Add smtp port
    "SenderName": "PostOShare",
    "SenderEmailRepository": "", // Add sender email
    "UserName": "", // Add username of smtp email account
    "Password": "" // Add password of smtp email account
  },
  "BaseUrl": "https://localhost:7224/", // Add the base URL for the API,
  "IdentityAPIUrl": "api/v1/auth",
  "PersonalAPIUrl": "api/v1/user",
  "ConnectionStrings": {
    "ConnectionDB": "" // Add connection string for database
  },
  "Jwt": {
    "SigningKey": "my-super-secure-issuer-signing-key-2026",
    "Issuer": "https://www.postoshare.com/"
  }
}
